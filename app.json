{
  "expo": {
    "name": "Synapse",
    "slug": "synapse",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "synapse",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#09090b",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.synapse.app",
      "buildNumber": "1",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Synapse necesita acceso a la cámara para tomar fotografías de apuntes, tareas o pizarras y adjuntarlas a tus entregas.",
        "NSPhotoLibraryUsageDescription": "Synapse necesita acceso a tu galería de fotos para seleccionar imágenes de tareas o cargar tu credencial digital estudiantil."
      }
    },
    "android": {
      "package": "com.synapse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Synapse necesita acceso a tu galería de fotos para seleccionar imágenes de tareas o cargar tu credencial digital estudiantil.",
          "cameraPermission": "Synapse necesita acceso a la cámara para tomar fotografías de apuntes, tareas o pizarras y adjuntarlas a tus entregas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#09090b"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.synapse.app",
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "*/*"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "33945317-49bf-4dd1-a124-8f0351e63033"
      }
    }
  }
}
