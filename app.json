{
  "expo": {
    "name": "Synapse",
    "slug": "synapse",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "synapse",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#09090b",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.synapse.app",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.synapse.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.synapse.app",
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "*/*"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "33945317-49bf-4dd1-a124-8f0351e63033"
      }
    }
  }
}
